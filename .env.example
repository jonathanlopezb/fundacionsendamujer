# Variables de Entorno para Vercel — Fundación Senda Mujer

# Base de Datos MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/fundacion_senda_mujer?retryWrites=true&w=majority

# Groq AI API Key (Para el Chatbot SendaBot AI)
GROQ_API_KEY=gsk_...

# Vercel Blob Storage Token (Para carga de evidencias o documentos)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Acceso privado a fichas de caracterizacion. Configure valores distintos y largos en Vercel.
SURVEY_ANALYSIS_ACCESS_KEY=replace-with-a-long-unique-access-key
SURVEY_ANALYSIS_SESSION_SECRET=replace-with-a-long-random-session-secret

# Llave separada para operaciones administrativas destructivas.
SURVEY_ADMIN_KEY=replace-with-a-separate-admin-key
